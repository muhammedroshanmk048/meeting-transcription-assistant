# Transcription: "groq" (free key from https://console.groq.com/keys) or "local" (pip install -r requirements-local.txt)
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
# Leave empty to auto-detect, or force one, e.g. en
LANGUAGE=

# Only used when TRANSCRIBE_PROVIDER=local
LOCAL_MODEL=small
LOCAL_DEVICE=cpu
LOCAL_COMPUTE_TYPE=int8
# Speaker labels via WhisperX + pyannote: needs a free Hugging Face token with the pyannote model terms accepted
LOCAL_DIARIZE=false
HF_TOKEN=

# Summaries: "gemini" (free key from https://aistudio.google.com/apikey) or "ollama" (local, offline)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Public deployment limits (per browser session / IP)
MAX_UPLOAD_MB=25
MAX_AUDIO_MINUTES=45
JOB_TTL_MINUTES=60
MAX_JOBS_PER_SESSION=5
JOBS_PER_HOUR_PER_IP=5
GROQ_AUDIO_SECONDS_PER_HOUR=7200
